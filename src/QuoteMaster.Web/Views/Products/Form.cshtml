@model ProductFormViewModel
@{
    var isEdit = Model.Id.HasValue;
    ViewData["Title"] = isEdit ? "Editar item" : "Novo item";
}
<div class="page-heading"><div><a class="back-link" asp-action="Index"><i class="bi bi-arrow-left"></i> Voltar para o catálogo</a><h1>@(isEdit ? "Editar item" : "Novo item")</h1><p>Defina as informações que aparecerão como referência nos novos orçamentos.</p></div></div>
<section class="form-layout">
    <form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post" class="surface-card form-card">
        @if (isEdit) { <input asp-for="Id" type="hidden" /> }
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <div class="form-section-heading"><span class="section-icon"><i class="bi bi-box-seam"></i></span><div><h2>Informações do catálogo</h2><p>Produtos e serviços podem ser ajustados a qualquer momento.</p></div></div>
        <div class="row g-3">
            <div class="col-md-8"><label asp-for="Name" class="form-label required-label"></label><input asp-for="Name" class="form-control" placeholder="Ex.: Instalação de equipamento" /><span asp-validation-for="Name" class="field-validation"></span></div>
            <div class="col-md-4"><label asp-for="Type" class="form-label"></label><select asp-for="Type" asp-items="Html.GetEnumSelectList<ProductType>()" class="form-select"></select><span asp-validation-for="Type" class="field-validation"></span></div>
            <div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="3" placeholder="Detalhes opcionais sobre este item"></textarea><span asp-validation-for="Description" class="field-validation"></span></div>
            <div class="col-md-6"><label asp-for="DefaultPrice" class="form-label"></label><div class="input-group money-input"><span class="input-group-text">R$</span><input asp-for="DefaultPrice" class="form-control" type="number" min="0" step="0.01" placeholder="0,00" /><span asp-validation-for="DefaultPrice" class="field-validation"></span></div></div>
        </div>
        <div class="form-actions"><a class="btn btn-light" asp-action="Index">Cancelar</a><button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i>@(isEdit ? "Salvar alterações" : "Adicionar ao catálogo")</button></div>
    </form>
    <aside class="form-aside"><div class="aside-icon"><i class="bi bi-clock-history"></i></div><h3>Histórico protegido</h3><p>O orçamento salva uma cópia da descrição e do preço no momento da criação. Atualizar o catálogo não muda propostas antigas.</p><div class="aside-note"><i class="bi bi-lightbulb"></i><span>Itens desativados continuam aparecendo nos orçamentos anteriores.</span></div></aside>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
