@if (TempData["Success"] is string success)
{
    <div class="alert alert-success app-alert" role="status"><i class="bi bi-check-circle-fill"></i><span>@success</span><button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button></div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger app-alert" role="alert"><i class="bi bi-exclamation-circle-fill"></i><span>@error</span><button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button></div>
}
