@{
    ViewData["Title"] = "Ocorreu um problema";
}
<section class="empty-state error-state">
    <span class="empty-icon"><i class="bi bi-exclamation-triangle"></i></span>
    <h1>Não foi possível concluir esta ação</h1>
    <p>Ocorreu um erro inesperado. Volte ao início e tente novamente.</p>
    <a class="btn btn-primary" asp-controller="Dashboard" asp-action="Index">Voltar ao dashboard</a>
</section>
